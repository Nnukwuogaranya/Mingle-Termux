/* =========================================================
   MINGLE — PREMIUM AUTHENTICATION
   ========================================================= */

:root {
  --mingle-navy: #18233f;
  --mingle-purple: #6f42c1;
  --mingle-purple-dark: #51259b;
  --champagne: #d4af37;
  --champagne-light: #ffe9a6;
  --champagne-bright: #f7d774;
  --pearl: #fffdf7;
  --glass: rgba(255, 255, 255, 0.18);
  --glass-border: rgba(255, 255, 255, 0.42);
  --text-dark: #20243a;
  --muted: rgba(32, 36, 58, 0.68);
  --danger: #9d2929;
}

/* =========================================================
   GLOBAL
   ========================================================= */

* {
  box-sizing: border-box;
}

html,
body,
#root {
  width: 100%;
  min-height: 100%;
  margin: 0;
}

body {
  font-family:
    Inter,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Roboto,
    Arial,
    sans-serif;

  overflow-x: hidden;
}

/* =========================================================
   AUTH PAGE
   ========================================================= */

.auth-page,
.auth-container {
  position: relative;
  min-height: 100dvh;
  width: 100%;
  overflow: hidden;

  display: flex;
  align-items: center;
  justify-content: center;

  background: linear-gradient(135deg, #071b3a 0%, #183f70 45%, #071b3a 100%);

  isolation: isolate;
}

/*
   Very light premium atmosphere.
   Intentionally NOT dark.
*/

.auth-page::before,
.auth-container::before {
  content: "";
  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.04),
      rgba(255, 255, 255, 0.10)
    );

  pointer-events: none;
  z-index: -1;
}

/* =========================================================
   FLOATING PARTICLES
   ========================================================= */

.particles {
  position: fixed;
  inset: 0;
  z-index: 0;

  pointer-events: none;
  overflow: hidden;
}

.particle {
  position: absolute;

  width: 4px;
  height: 4px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(255, 235, 155, 0.95),
      rgba(212, 175, 55, 0.18)
    );

  box-shadow:
    0 0 8px rgba(212, 175, 55, 0.45);

  animation:
    mingleFloat linear infinite;

  opacity: 0.7;
}

@keyframes mingleFloat {
  0% {
    transform: translateY(105vh) scale(0.7);
    opacity: 0;
  }

  15% {
    opacity: 0.8;
  }

  75% {
    opacity: 0.65;
  }

  100% {
    transform: translateY(-15vh) scale(1.15);
    opacity: 0;
  }
}

/* =========================================================
   AUTH CARD
   ========================================================= */

.auth-card {
  position: relative;
  z-index: 5;

  width: min(94%, 470px);
  max-height: 94dvh;

  overflow-y: auto;

  padding: 30px 32px 25px;

  border-radius: 30px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.52),
      rgba(255, 255, 255, 0.25)
    );

  border: 1px solid var(--glass-border);

  box-shadow:
    0 30px 80px rgba(23, 35, 66, 0.20),
    0 10px 35px rgba(212, 175, 55, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.75);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);

  scrollbar-width: thin;
  scrollbar-color: rgba(111, 66, 193, 0.35) transparent;
}

.auth-card::-webkit-scrollbar {
  width: 4px;
}

.auth-card::-webkit-scrollbar-track {
  background: transparent;
}

.auth-card::-webkit-scrollbar-thumb {
  background: rgba(111, 66, 193, 0.35);
  border-radius: 20px;
}

/* =========================================================
   LOGO
   ========================================================= */

.logo-wrap {
  text-align: center;
  margin-bottom: 20px;
}

.logo-circle {
  width: 68px;
  height: 68px;

  margin: 0 auto 9px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background:
    radial-gradient(
      circle at 35% 30%,
      #fff9d9 0%,
      var(--champagne-light) 28%,
      var(--champagne) 58%,
      #a98218 100%
    );

  border: 2px solid rgba(255, 255, 255, 0.8);

  box-shadow:
    0 8px 25px rgba(145, 107, 13, 0.25),
    0 0 30px rgba(212, 175, 55, 0.28),
    inset 0 2px 5px rgba(255, 255, 255, 0.7);
}

.logo-m {
  font-family: Georgia, "Times New Roman", serif;

  font-size: 42px;
  font-weight: 900;

  line-height: 1;

  color: #fffdf1;

  text-shadow:
    0 2px 4px rgba(91, 64, 4, 0.35),
    0 0 10px rgba(255, 245, 190, 0.6);
}

.app-title {
  margin: 0;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: clamp(27px, 7vw, 34px);

  letter-spacing: 0.18em;

  font-weight: 800;

  color: var(--mingle-purple);

  text-shadow:
    0 2px 8px rgba(255, 255, 255, 0.65);
}

/* =========================================================
   TAGLINE
   ========================================================= */

.tagline {
  margin: 7px auto 0;

  max-width: 330px;

  font-size: 13px;
  line-height: 1.5;

  font-weight: 600;

  color: var(--text-dark);

  opacity: 0.86;

  animation: taglineReveal 5s ease-in-out infinite;
}

@keyframes taglineReveal {
  0%,
  100% {
    opacity: 0.72;
    transform: translateY(2px);
  }

  50% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* =========================================================
   LOGIN / REGISTER TABS
   ========================================================= */

.auth-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;

  gap: 5px;

  padding: 5px;

  margin-bottom: 18px;

  border-radius: 16px;

  background: rgba(255, 255, 255, 0.35);

  border: 1px solid rgba(255, 255, 255, 0.38);
}

.auth-tabs button {
  border: 0;
  outline: none;

  min-height: 42px;

  border-radius: 12px;

  background: transparent;

  color: rgba(32, 36, 58, 0.65);

  font-size: 14px;
  font-weight: 750;

  cursor: pointer;

  transition:
    color 0.25s ease,
    background 0.25s ease,
    box-shadow 0.25s ease,
    transform 0.2s ease;
}

.auth-tabs button:hover {
  color: var(--mingle-purple);
}

.auth-tabs button.active {
  color: #fff;

  background:
    linear-gradient(
      135deg,
      var(--mingle-purple),
      #8a5bd1
    );

  box-shadow:
    0 6px 18px rgba(111, 66, 193, 0.28);
}

.auth-tabs button:active {
  transform: scale(0.98);
}

/* =========================================================
   INPUT GROUP
   ========================================================= */

.input-group {
  margin-bottom: 14px;
}

.input-group label {
  display: block;

  margin: 0 0 6px 4px;

  color: var(--text-dark);

  font-size: 13px;
  font-weight: 750;
}

/* =========================================================
   INPUT BOX
   ========================================================= */

.password-box {
  position: relative;
  width: 100%;
}

.password-box input {
  width: 100%;
  height: 52px;

  padding: 0 45px 0 45px;

  border: 1px solid rgba(255, 255, 255, 0.68);

  border-radius: 15px;

  outline: none;

  background:
    rgba(255, 255, 255, 0.72);

  color: var(--text-dark);

  font-family: inherit;

  font-size: 14px;
  font-weight: 600;

  box-shadow:
    inset 0 1px 3px rgba(30, 35, 60, 0.06),
    0 3px 12px rgba(30, 35, 60, 0.06);

  transition:
    border-color 0.25s ease,
    box-shadow 0.25s ease,
    background 0.25s ease;
}

.password-box input::placeholder {
  color: rgba(32, 36, 58, 0.68);
  opacity: 1;
}

.password-box input:focus {
  background: rgba(255, 255, 255, 0.9);

  border-color: rgba(212, 175, 55, 0.85);

  box-shadow:
    0 0 0 3px rgba(212, 175, 55, 0.13),
    0 7px 20px rgba(212, 175, 55, 0.10);
}

/*
   Existing FontAwesome icons receive their colour here.
   Normal login fields are GOLD, NOT Pi purple.
*/

.password-box > svg {
  color: var(--champagne) !important;
}

/* =========================================================
   PASSWORD EYE
   ========================================================= */

.password-toggle {
  position: absolute;

  right: 15px;
  top: 50%;

  transform: translateY(-50%);

  display: flex;
  align-items: center;
  justify-content: center;

  width: 28px;
  height: 28px;

  border-radius: 50%;

  color: rgba(32, 36, 58, 0.60);

  cursor: pointer;

  transition:
    color 0.2s ease,
    background 0.2s ease;
}

.password-toggle:hover {
  color: var(--champagne);

  background: rgba(212, 175, 55, 0.10);
}

/* =========================================================
   ERROR / SUCCESS
   ========================================================= */

.auth-card > div[style*="ffb4b4"] {
  color: var(--danger) !important;

  background:
    rgba(255, 255, 255, 0.58) !important;

  border:
    1px solid rgba(157, 41, 41, 0.18);
}

.auth-card > div[style*="d4af37"] {
  color: #8b6b13 !important;

  background:
    rgba(255, 250, 224, 0.68) !important;

  border:
    1px solid rgba(212, 175, 55, 0.25);
}

/* =========================================================
   OPTIONS
   ========================================================= */

.options-row {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 12px;

  margin: 5px 2px 17px;

  font-size: 12px;
}

.remember-me {
  display: flex;
  align-items: center;

  gap: 7px;

  color: var(--text-dark);

  font-weight: 650;

  cursor: pointer;
}

.remember-me input {
  width: 15px;
  height: 15px;

  accent-color: var(--champagne);

  cursor: pointer;
}

.forgot-link {
  color: var(--text-dark);

  font-weight: 750;

  text-decoration: none;

  transition:
    color 0.2s ease;
}

.forgot-link:hover {
  color: var(--champagne);
}

/* =========================================================
   PREMIUM V-SHAPED BUTTON SYSTEM
   ========================================================= */

.login-btn,
.pi-btn {
  position: relative;

  width: 100%;
  min-height: 54px;

  border: 0;

  clip-path:
    polygon(
      0 0,
      100% 0,
      96% 50%,
      100% 100%,
      0 100%,
      4% 50%
    );

  cursor: pointer;

  font-family: inherit;

  font-size: 14px;

  font-weight: 850;

  letter-spacing: 0.04em;

  transition:
    transform 0.2s ease,
    filter 0.25s ease,
    box-shadow 0.25s ease;

  overflow: hidden;
}

.login-btn::before,
.pi-btn::before {
  content: "";

  position: absolute;

  inset: 0;

  background:
    linear-gradient(
      105deg,
      transparent 20%,
      rgba(255, 255, 255, 0.45) 48%,
      transparent 68%
    );

  transform: translateX(-120%);

  transition: transform 0.65s ease;

  pointer-events: none;
}

.login-btn:hover::before,
.pi-btn:hover::before {
  transform: translateX(120%);
}

.login-btn:hover,
.pi-btn:hover {
  transform: translateY(-2px);
}

.login-btn:active,
.pi-btn:active {
  transform: translateY(1px);
}

.login-btn:disabled,
.pi-btn:disabled {
  opacity: 0.65;

  cursor: not-allowed;

  transform: none;
}

/* =========================================================
   NORMAL MINGLE LOGIN
   CHAMPAGNE GOLD ONLY
   ========================================================= */

.login-btn {
  color: #342806;

  background:
    linear-gradient(
      135deg,
      #b98b1f 0%,
      var(--champagne-light) 22%,
      var(--champagne-bright) 47%,
      var(--champagne) 70%,
      #a67b16 100%
    );

  box-shadow:
    0 9px 25px rgba(160, 119, 19, 0.28),
    inset 0 1px 0 rgba(255, 255, 255, 0.8);

  text-shadow:
    0 1px 1px rgba(255, 255, 255, 0.35);
}

.login-btn:hover {
  filter: brightness(1.06);

  box-shadow:
    0 13px 30px rgba(160, 119, 19, 0.34),
    0 0 22px rgba(212, 175, 55, 0.20);
}

/* =========================================================
   PI LOGIN
   PURPLE ONLY
   ========================================================= */

.pi-btn {
  margin-top: 2px;

  color: #ffffff;

  background:
    linear-gradient(
      135deg,
      #5b2ca8,
      var(--mingle-purple),
      #895bd1
    );

  box-shadow:
    0 9px 25px rgba(111, 66, 193, 0.30),
    inset 0 1px 0 rgba(255, 255, 255, 0.28);
}

.pi-btn:hover {
  filter: brightness(1.07);

  box-shadow:
    0 13px 30px rgba(111, 66, 193, 0.38),
    0 0 22px rgba(111, 66, 193, 0.22);
}

/* =========================================================
   DIVIDER
   ========================================================= */

.divider {
  display: flex;
  align-items: center;

  gap: 12px;

  margin: 15px 0;

  color: rgba(32, 36, 58, 0.55);

  font-size: 11px;
  font-weight: 800;

  letter-spacing: 0.16em;
}

.divider::before,
.divider::after {
  content: "";

  flex: 1;

  height: 1px;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(32, 36, 58, 0.20)
    );
}

.divider::after {
  background:
    linear-gradient(
      90deg,
      rgba(32, 36, 58, 0.20),
      transparent
    );
}

/* =========================================================
   FOOTER
   ========================================================= */

.footer-text {
  margin-top: 18px;

  text-align: center;

  color: rgba(32, 36, 58, 0.72);

  font-size: 12px;

  font-weight: 600;
}

.footer-text a {
  color: var(--mingle-purple);

  font-weight: 850;

  text-decoration: none;

  transition:
    color 0.2s ease;
}

.footer-text a:hover {
  color: var(--champagne);
}

/* =========================================================
   RESPONSIVE — TABLETS
   ========================================================= */

@media (max-width: 768px) {
  .auth-card {
    width: min(92%, 460px);

    padding:
      27px
      25px
      23px;

    border-radius: 27px;
  }

  .logo-circle {
    width: 62px;
    height: 62px;
  }

  .logo-m {
    font-size: 38px;
  }

  .app-title {
    font-size: 29px;
  }
}

/* =========================================================
   RESPONSIVE — PHONES
   ========================================================= */

@media (max-width: 520px) {
  .auth-page,
  .auth-container {
    align-items: center;

    padding:
      12px
      10px;
  }

  .auth-card {
    width: 100%;

    max-height: 96dvh;

    padding:
      23px
      18px
      20px;

    border-radius: 24px;

    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .logo-wrap {
    margin-bottom: 15px;
  }

  .logo-circle {
    width: 56px;
    height: 56px;

    margin-bottom: 7px;
  }

  .logo-m {
    font-size: 34px;
  }

  .app-title {
    font-size: 26px;

    letter-spacing: 0.15em;
  }

  .tagline {
    max-width: 290px;

    font-size: 11.5px;
  }

  .auth-tabs {
    margin-bottom: 15px;
  }

  .auth-tabs button {
    min-height: 40px;

    font-size: 13px;
  }

  .input-group {
    margin-bottom: 11px;
  }

  .input-group label {
    font-size: 12px;
  }

  .password-box input {
    height: 49px;

    font-size: 13px;
  }

  .options-row {
    margin-bottom: 14px;

    font-size: 11px;
  }

  .login-btn,
  .pi-btn {
    min-height: 51px;

    font-size: 13px;
  }

  .footer-text {
    margin-top: 15px;

    font-size: 11.5px;
  }
}

/* =========================================================
   VERY SMALL PHONES
   ========================================================= */

@media (max-height: 700px) and (max-width: 520px) {
  .auth-card {
    padding-top: 17px;
    padding-bottom: 15px;
  }

  .logo-circle {
    width: 48px;
    height: 48px;
  }

  .logo-m {
    font-size: 29px;
  }

  .app-title {
    font-size: 23px;
  }

  .tagline {
    margin-top: 4px;
  }

  .auth-tabs {
    margin-bottom: 10px;
  }

  .input-group {
    margin-bottom: 8px;
  }

  .password-box input {
    height: 45px;
  }

  .login-btn,
  .pi-btn {
    min-height: 47px;
  }

  .divider {
    margin: 10px 0;
  }

  .footer-text {
    margin-top: 11px;
  }
}

/* =========================================================
   ACCESSIBILITY
   ========================================================= */

button:focus-visible,
input:focus-visible,
a:focus-visible {
  outline: 2px solid var(--champagne);

  outline-offset: 3px;
}

/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}
